# ==============================================================================
# LegalMetro Shield - Environment Configuration Template
# ==============================================================================

# Application
PROJECT_NAME="LegalMetro Shield"
ENV="development"
API_V1_STR="/api/v1"

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/legalmetro"

# Redis (Task Broker & Pub/Sub Events)
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="legalmetro-scans"
MINIO_SECURE=false

# AI & Vision Extraction
# OCR_PROVIDER can be "gemini", "groq", or "tesseract"
OCR_PROVIDER="gemini"

# Google Gemini Vision
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Groq LLM Provider & Multi-Model Fallbacks
# Supported models & rate limits:
# - groq/compound              (30 RPM, 250 RPD, 70K TPM)
# - groq/compound-mini         (30 RPM, 250 RPD, 70K TPM)
# - openai/gpt-oss-120b        (30 RPM, 1K RPD, 8K TPM, 200K TPD)
# - openai/gpt-oss-20b         (30 RPM, 1K RPD, 8K TPM, 200K TPD)
# - openai/gpt-oss-safeguard-20b (30 RPM, 1K RPD, 8K TPM, 200K TPD)
# - qwen/qwen3.6-27b           (30 RPM, 1K RPD, 8K TPM, 200K TPD)
# - qwen/qwen3.8-27b           (30 RPM, 1K RPD, 8K TPM, 200K TPD)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="groq/compound"
GROQ_FALLBACK_MODELS='["groq/compound", "groq/compound-mini", "openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3.8-27b"]'

# Authentication & Security
JWT_SECRET="dev-insecure-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMITING_ENABLED=true

# CORS Allowed Origins (JSON array)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
