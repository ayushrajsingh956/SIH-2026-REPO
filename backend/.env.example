# Database (PostgreSQL 16 with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legalmetro

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
# Endpoint browsers use for presigned URLs (must resolve from the client;
# inside docker-compose set to http://localhost:9000 while containers use minio:9000)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=legalmetro-scans
MINIO_SECURE=false

# AI & OCR Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_PROVIDER=gemini

# Authentication & Security
JWT_SECRET=dev-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment & CORS
ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
