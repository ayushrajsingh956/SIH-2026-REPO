# Global Environment Variables for Docker Compose

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legalmetro

# Object Storage (MinIO)
# Public endpoint browsers use to fetch presigned image URLs.
# Must be resolvable from the CLIENT machine, not the docker-internal hostname.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# AI / Vision
# OCR_PROVIDER: gemini | groq (primary vision provider)
OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound

# Security
JWT_SECRET=dev-insecure-secret-key-change-in-production-min-32-chars
